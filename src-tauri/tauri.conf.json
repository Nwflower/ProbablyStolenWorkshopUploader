{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Probably Stolen Workshop Uploader",
  "version": "0.1.0",
  "identifier": "io.nwflower.workshop-uploader.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "深空当铺 · 创意工坊上传器",
        "width": 1220,
        "height": 880,
        "label": "main",
        "minWidth": 720,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
