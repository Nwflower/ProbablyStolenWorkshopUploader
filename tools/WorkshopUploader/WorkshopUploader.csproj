<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      WinUI 3（Windows App SDK）。界面是 Windows 10/11 原生 Fluent 控件。
      构建需要：.NET 8 SDK + Visual Studio 2022 Build Tools 的 UWP/MSIX 组件（Pri.Tasks / AppxPackage）。
      用 dotnet build 构建会因缺少上述 MSBuild 任务失败，请用 build.ps1（走 VS 的 MSBuild）。
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ProbablyStolenWorkshopUploader</RootNamespace>
    <AssemblyName>ProbablyStolenWorkshopUploader</AssemblyName>
    <Version>1.0.3</Version>
    <Authors>千川白浪(Nwflower)</Authors>
    <Copyright>Copyright (c) 2026 千川白浪(Nwflower)</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\probably-stolen.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- 自包含 Windows App SDK：不依赖玩家机器上装了哪个版本的 Windows App Runtime。 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 自定义 BaseOutputPath 时仍排除项目内所有历史构建，避免资源被递归打包。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="packaging\**\*.cs" />
    <Content Include="Assets\probably-stolen.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\probably-stolen.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\change-preview.svg" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Steamworks.NET">
      <HintPath>lib\Steamworks.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="lib\steam_api64.dll">
      <Link>steam_api64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="steam_appid.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
